asr:
  cache_dir: "./models"
  hub: "ms"
  batch_size_s: 300
  batch_size_threshold_s: 60
  hotword: ""
  idle_unload_minutes: 30
  stream_engine: "funasr"          # funasr=内置实时引擎（Mac/WSL通用）；sidecar=Fun-ASR-Nano vLLM（仅WSL+NVIDIA）
  stream_language: "中文"
  sidecar_url: "ws://localhost:10095"

llm:
  mode: api
  api:
    base_url: "https://open.bigmodel.cn/api/paas/v4"
    api_key: "${LLM_API_KEY}"
    model: "glm-4-flash"
  ollama:
    base_url: "http://localhost:11434/v1"
    model: "qwen2.5:7b"
    api_key: "ollama"
  polish_chunk_minutes: 6
  temperature: 0.3
  max_retries: 2

server:
  host: "0.0.0.0"
  port: 8000
  ssl:
    enabled: false          # 设为 true 启用 HTTPS，局域网访问时可授权麦克风
    cert: "certs/cert.pem"  # 证书路径
    key: "certs/key.pem"    # 私钥路径
    auto_generate: true     # 首次启动时自动生成自签名证书

storage:
  data_dir: "./data"
